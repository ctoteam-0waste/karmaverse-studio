# Copy this file to .env.local and fill in only what you need.
# The app works fully WITHOUT any of these values (free template + manual modes).

# --- Optional: Claude API runtime generation -------------------------------
# A Claude.ai subscription does NOT include API credits. API usage is billed
# separately at https://console.anthropic.com. Leave empty to stay free.
ANTHROPIC_API_KEY=
# Model used when ANTHROPIC_API_KEY is set.
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Optional: where the local JSON database lives ----------------------------
# Defaults to ./data/db.json
DATA_FILE=

# --- Publishing Agent: platform API credentials --------------------------------
# These are API TOKENS from each platform's developer console, never account
# passwords. Leave a platform empty to keep it manual (post by hand).
# Restart the app after editing. The Publishing page shows what each brand has.
#
# Each brand has an ACCOUNT KEY (Settings > brand profile), e.g. KARMAVERSE.
# Its tokens use that prefix: KARMAVERSE_META_PAGE_ID=...
# A brand never uses another brand's tokens. The default brand (PUBLISH_BRAND_ID,
# or the first brand) may also use the names without a prefix.
PUBLISH_BRAND_ID=

# Shared settings (may also be set per brand with the prefix)
META_GRAPH_VERSION=v24.0
# YYYYMM; defaults to two months ago
LINKEDIN_API_VERSION=
# public, unlisted or private
YOUTUBE_PRIVACY=public

# --- Example: KarmaVerse (account key KARMAVERSE) ---
# Facebook Page: Meta app with pages_manage_posts; long-lived Page access token
KARMAVERSE_META_PAGE_ID=
KARMAVERSE_META_PAGE_ACCESS_TOKEN=
# Instagram professional account ID. Token: INSTAGRAM_ACCESS_TOKEN (Instagram
# Login) or leave empty to use the linked Facebook Page's token above.
KARMAVERSE_INSTAGRAM_ACCOUNT_ID=
KARMAVERSE_INSTAGRAM_ACCESS_TOKEN=
# LinkedIn company page: Community Management API; token expires after 60 days
KARMAVERSE_LINKEDIN_ACCESS_TOKEN=
KARMAVERSE_LINKEDIN_AUTHOR_URN=urn:li:organization:
# YouTube: Google Cloud OAuth client. Authorize these scopes together so the
# app can upload AND read metrics (also enable "YouTube Analytics API"):
#   https://www.googleapis.com/auth/youtube.upload
#   https://www.googleapis.com/auth/youtube.readonly
#   https://www.googleapis.com/auth/yt-analytics.readonly
#   https://www.googleapis.com/auth/youtube.force-ssl   (Community Manager: read and reply to comments)
KARMAVERSE_YOUTUBE_CLIENT_ID=
KARMAVERSE_YOUTUBE_CLIENT_SECRET=
KARMAVERSE_YOUTUBE_REFRESH_TOKEN=
# X: developer app with Read and Write permission; OAuth 1.0a keys and the
# account's access token + secret (generate the token AFTER setting Read and Write)
KARMAVERSE_X_API_KEY=
KARMAVERSE_X_API_SECRET=
KARMAVERSE_X_ACCESS_TOKEN=
KARMAVERSE_X_ACCESS_TOKEN_SECRET=

# Repeat the block for each brand with its own key, e.g. ZEROWASTE_META_PAGE_ID=...

# --- Media Host: public links for Instagram/Facebook media (shared by all brands) ---
# Free Cloudinary account > Settings > API Keys > "API environment variable".
CLOUDINARY_URL=
# Optional folder name in Cloudinary (default social-growth-agent)
CLOUDINARY_FOLDER=
# Or, if this app is reachable from the internet over https:
MEDIA_PUBLIC_BASE_URL=
